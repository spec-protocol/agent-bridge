# Copy to .env and adjust:  cp .env.example .env && chmod 600 .env
# Generate the token with:  openssl rand -hex 32
BRIDGE_TOKEN=REPLACE_WITH_GENERATED_TOKEN

# Local port (the server listens ONLY on 127.0.0.1)
PORT=8787

# Repository allowlist: name=/absolute/path,name2=/another/path
# The first entry is the default.
REPOS=my-repo=/absolute/path/to/your/repository

# Absolute path of the Cursor CLI. install.sh fills this with `command -v agent` when it exists.
AGENT_BIN=/absolute/path/to/agent

# 1 = allow mode="agent" with --force (Cursor MAY EDIT files). Default: off.
ALLOW_WRITE=0

# Optional
# CURSOR_MODEL=composer-2.5   # or auto — IDs from `agent models`, not UI names
# CURSOR_TRUST=1          # passes --trust (trusts the workspace without a prompt; required headless). 0 turns it off.
# CURSOR_SANDBOX=enabled  # passes --sandbox enabled|disabled
# MAX_OUTPUT_BYTES=200000
# MAX_TIMEOUT_SEC=1800
# GIT_TIMEOUT_SEC=120
# MCP_PATH=/mcp
# MAX_READ_BYTES=300000           # maximum size for read_file
# READ_DENY_GLOBS=*.sql,storage/** # extra blocks for read_file/list_files (on top of the built-in ones)
# BRIDGE_MCP_URL=https://bridge.example.com/mcp  # optional: named tunnel (scripts/grok-reconnect.sh)

# OpenCode (optional — ask_opencode tool; the bridge works without OpenCode)
# OPENCODE_DISABLE=1
# OPENCODE_BIN=/absolute/path/to/opencode
# OPENCODE_MODEL=opencode/glm-5.3-flash-free
# OPENCODE_AUTO=0   # 1 = --auto on opencode run (headless; use with care)
# OPENCODE_AGENT=plan   # only allowed value; ask_opencode uses opencode run --agent plan
# BRIDGE_OPENCODE_JSON=1   # 0 = default output (no NDJSON); default 1 since 2.2.1

# Async jobs (2.2.0+) — start_ask_cursor / get_job for long Grok tasks
# JOB_RETENTION_HOURS=24

# Local audit (2.2.2+) — metadata by default, no sensitive body
# BRIDGE_AUDIT=1
# BRIDGE_AUDIT_BODY=0   # 1 stores prompt/response (opt-in; do not use if logs leave the machine)
# BRIDGE_AUDIT_DIR=     # optional; default ~/.local/share/agent-bridge/
